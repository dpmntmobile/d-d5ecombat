      \"current\": \"Rogue\"
    },
    \"repeating_traits_-iviB4yrxfwdQda8nCj6_name\": {
      \"current\": \"Mask of the Wild\"
    },
    \"repeating_traits_-iviB4yrxfwdQda8nCj6_description\": {
      \"current\": \"You can attempt to hide even when you are only lightly obscured by foliage, heavy rain, falling snow, mist, and other natural phenomena.\"
    },
    \"repeating_traits_-ZyJPanOMKG131ZPE1cZ_source_type\": {
      \"current\": \"Rogue\"
